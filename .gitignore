# Miscellaneous
.cache/
.cache*/
# golden 测试失败时的差异图，不入库
test/failures/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Android signing (keep keystore & credentials out of VCS)
android/key.properties
android/**/*.jks
android/**/*.keystore
android/**/*.b64

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend is a separate repo nested inside this one; leave it as-is.
/dnaisland/

# Local-only dev material: reference checkouts, model workspace, research dumps.
/local/
# gh CLI / 工具链写下的本机状态（设备 id 等），不随仓库分发。
/.local/
